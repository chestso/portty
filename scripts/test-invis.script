# Test: invisible text attribute (SGR 8)
# Run: build/src/portty -S scripts/test-invis.script
# Expected: "VISIBLE" appears, "HIDDEN" does NOT appear (background only)

wait 0.5
emit \e[2J\e[H
emit VISIBLE\r\n
emit \e[8mHIDDEN\e[0m\r\n
emit \e[41m\e[8mRED_BG\e[0m done\r\n
wait 0.5
dumprow 0
dumprow 1
dumprow 2
screendump /tmp/portty-test-invis.png
quit
