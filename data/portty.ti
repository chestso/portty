portty-vty-256color|portty-256color|portty|Portty Terminal Emulator,
    use=xterm-256color,
    cnorm=\E[?12h\E[?25h,
    Tc,
    hs,
    tsl=\E]2;,
    fsl=\E\\,
    dsl=\E]2;\E\\,
    Smulx=\E[4\:%p1%dm,
    Setulc=\E[58\:2\:\:%p1%{65536}%/%d\:%p1%{256}%/%{255}%&%d\:%p1%{255}&%d%;m,
    Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,
