# Enforce LF line endings for all text files — this project is developed
# primarily on GNU/Linux.  Git's core.autocrlf on Windows would silently
# convert LF to CRLF in the working tree and back on commit, but that
# causes diff noise and can break shell scripts and Makefile recipes.
# Pin everything to LF so the working tree matches what's in the repo.

* text=auto eol=lf

# Windows-native scripts need CRLF for cmd/PowerShell to handle correctly
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.iss  text eol=crlf
*.nsi  text eol=crlf

# Example demo files are cat-able but use CRLF so they render identically
# when piped to a terminal on Windows (cmd echoes CRLF natively).
examples/** text eol=crlf

# Binary files — don't touch
*.png  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.so   binary
*.o    binary
*.a    binary
*.spv  binary
