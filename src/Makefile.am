# src/Makefile.am - Build rules for portty source files

# Regenerate portty_version.h on every `make` so the embedded version string
# tracks the current git HEAD. The recipe always runs, but the file is only
# rewritten when the version actually changes — so dependent .o files stay
# cached when nothing changed.
BUILT_SOURCES = portty_version.h
CLEANFILES = portty_version.h portty-resources.o

.PHONY: portty_version_force regen-shaders regen-icon
portty_version.h: portty_version_force
	@v=`"$(top_srcdir)/build-aux/git-version.sh" "$(top_srcdir)" 2>/dev/null`; \
	test -n "$$v" || v="$(PORTTY_VERSION)"; \
	test -n "$$v" || v="unknown"; \
	printf '#ifndef PORTTY_VERSION_H\n#define PORTTY_VERSION_H\n#define PORTTY_VERSION "%s"\n#endif\n' "$$v" > $@.tmp; \
	if cmp -s $@.tmp $@ 2>/dev/null; then \
	  rm -f $@.tmp; \
	else \
	  mv $@.tmp $@; \
	  echo "  GEN      $@ ($$v)"; \
	fi
portty_version_force:

bin_PROGRAMS = portty

# Platform-specific implementations
if HOST_WINDOWS
PTY_SOURCE = pty_w32.c
FONT_RESOLVE_SOURCE = font_resolve_w32.c
else !HOST_WINDOWS
PTY_SOURCE = pty.c
if HOST_MACOS
FONT_RESOLVE_SOURCE = font_resolve_ct.c
else
FONT_RESOLVE_SOURCE = font_resolve_fc.c
endif
endif

# Shared sources — compiled for both backends
PORTTY_COMMON_SRC = \
    portty_app.c \
    term.c term_cfr.c \
    $(PTY_SOURCE) \
    $(FONT_RESOLVE_SOURCE) \
    font_resolve.c font.c font_ft.c \
    colr.c unicode.c base64.c \
    png_writer.c png_reader.c \
    portty_conf.c diag.c pager.c timer.c path_compat.c os_compat.c display_info.c \
    portty_bug.c heap_harden.c \
    rend_common.c rend_boxdraw.c \
    portty_debug_script.c

PORTTY_COMMON_CFLAGS = $(FREETYPE_CFLAGS) $(HARFBUZZ_CFLAGS) \
    $(LIBPNG_CFLAGS) $(COFFER_CFLAGS)
PORTTY_COMMON_LDADD = $(FREETYPE_LIBS) $(HARFBUZZ_LIBS) \
    $(LIBPNG_LIBS) $(COFFER_LIBS) -lm

if BACKEND_SDL3
portty_SOURCES = main_sdl3.c $(PORTTY_COMMON_SRC) \
    backend_sdl3.c rend_sdl3.c rend_sdl3_atlas.c \
    rend_sdl3_shader.c
portty_CFLAGS = $(PORTTY_COMMON_CFLAGS) $(SDL3_CFLAGS) \
    -DPORTTY_DATADIR='"$(datadir)"' -Wall -Wextra
portty_LDADD = $(PORTTY_COMMON_LDADD)
endif

if BACKEND_SOKOL
portty_SOURCES = main_sokol.c $(PORTTY_COMMON_SRC) \
    backend_sokol.c rend_sokol_atlas.c
portty_CFLAGS = $(PORTTY_COMMON_CFLAGS) $(SOKOL_CFLAGS) -I$(top_srcdir) \
    -DPORTTY_DATADIR='"$(datadir)"' -Wall -Wextra
portty_LDADD = $(PORTTY_COMMON_LDADD)
endif

if BACKEND_SDL3
portty_LDADD += $(SDL3_LIBS)
endif
if BACKEND_SOKOL
portty_LDADD += $(PLATFORM_LIBS)
endif

if HAVE_RC
portty_resources = portty-resources.o
else
portty_resources =
endif

if BACKEND_SDL3
portty_LDADD += $(SDL3_LIBS) $(portty_resources)
endif
if BACKEND_SOKOL
portty_LDADD += $(PLATFORM_LIBS) $(portty_resources)
endif

# Fontconfig is Linux-only (not on macOS or Windows)
if !HOST_WINDOWS
if !HOST_MACOS
PORTTY_COMMON_CFLAGS += $(FONTCONFIG_CFLAGS)
PORTTY_COMMON_LDADD += $(FONTCONFIG_LIBS)
PORTTY_COMMON_LDADD += -lutil
endif
endif

# GPU glyph-coverage shader. The compiled SPIR-V is committed as a C header
# (shaders/glyph_coverage_frag_spv.h, generated by build-aux/bin2c.sh), so
# glslang is NOT a build dependency — the normal build just compiles the header.
# After editing the .glsl, run `make regen-shaders` (needs glslangValidator) to
# refresh the committed header, then commit it.
EXTRA_DIST = shaders/glyph_coverage.frag.glsl shaders/glyph_coverage_frag_spv.h \
    shaders/glyph_coverage_sokol.h portty.rc portty_icon_png.h

if HAVE_GLSLANGVALIDATOR
regen-shaders:
	@$(MKDIR_P) shaders
	$(GLSLANGVALIDATOR) -V -S frag \
	    $(srcdir)/shaders/glyph_coverage.frag.glsl \
	    -o shaders/glyph_coverage.frag.spv
	$(SHELL) $(top_srcdir)/build-aux/bin2c.sh \
	    shaders/glyph_coverage.frag.spv glyph_coverage_frag_spv \
	    > $(srcdir)/shaders/glyph_coverage_frag_spv.h
	@echo "  GEN      shaders/glyph_coverage_frag_spv.h"
CLEANFILES += shaders/glyph_coverage.frag.spv
endif

# Embedded window icon (256x256 PNG compiled into the binary as a C header
# via build-aux/bin2c.sh). After changing the source SVG, run `make regen-icon`
# (needs rsvg-convert) to refresh the committed header, then commit it.
regen-icon:
	rsvg-convert -w 256 -h 256 -f png \
	    $(top_srcdir)/data/icons/hicolor/scalable/apps/portty.svg \
	    -o $(srcdir)/portty_icon_256.png
	$(SHELL) $(top_srcdir)/build-aux/bin2c.sh \
	    $(srcdir)/portty_icon_256.png portty_icon_png \
	    > $(srcdir)/portty_icon_png.h
	@echo "  GEN      portty_icon_png.h"

if HAVE_RC
# Compile the Windows resource file (portty.rc) with windres to embed the
# app icon into the .exe. Automake has no built-in .rc → .o build rule, so we
# provide an explicit one and link the resulting object into portty.
portty-resources.o: $(srcdir)/portty.rc $(top_srcdir)/data/icons/portty.ico
	$(AM_V_GEN)$(RC) $(RCFLAGS) -I$(srcdir) -I$(top_srcdir)/data/icons -i $< -o $@
BUILT_SOURCES += portty-resources.o
endif HAVE_RC

if HOST_WINDOWS
if BACKEND_SDL3
portty_LDADD += -ladvapi32 -lshell32 -ldwmapi -lgdi32 -ldwrite -lwinpthread
endif
if BACKEND_SOKOL
portty_LDADD += -ld3d11 -ldxgi -lkernel32 -luser32 -lshell32 -lole32 -ladvapi32 -ldwrite -lgdi32 -ldwmapi -lwinpthread
endif
portty_LDFLAGS = -mwindows
else !HOST_WINDOWS
if HOST_MACOS
if BACKEND_SDL3
portty_LDFLAGS = -framework CoreText -framework CoreFoundation \
    -framework GameController -framework CoreHaptics \
    -framework CoreMotion -framework CoreMedia
else
portty_LDFLAGS = -framework AppKit -framework QuartzCore -framework Metal \
    -framework CoreText -framework CoreFoundation
endif
else
portty_LDFLAGS =
endif
endif

AM_CFLAGS = -I$(top_srcdir) -DPKGLIBDIR='"$(pkglibdir)"'
