# src/Makefile.am - Build rules for bloom-terminal source files

# Regenerate bloom_version.h on every `make` so the embedded version string
# tracks the current git HEAD. The recipe always runs, but the file is only
# rewritten when the version actually changes — so dependent .o files stay
# cached when nothing changed.
BUILT_SOURCES = bloom_version.h
CLEANFILES = bloom_version.h

.PHONY: bloom_version_force regen-shaders
bloom_version.h: bloom_version_force
	@v=`"$(top_srcdir)/build-aux/git-version.sh" "$(top_srcdir)" 2>/dev/null`; \
	test -n "$$v" || v="$(BLOOM_TERMINAL_VERSION)"; \
	test -n "$$v" || v="unknown"; \
	printf '#ifndef BLOOM_VERSION_H\n#define BLOOM_VERSION_H\n#define BLOOM_TERMINAL_VERSION "%s"\n#endif\n' "$$v" > $@.tmp; \
	if cmp -s $@.tmp $@ 2>/dev/null; then \
	  rm -f $@.tmp; \
	else \
	  mv $@.tmp $@; \
	  echo "  GEN      $@ ($$v)"; \
	fi
bloom_version_force:

bin_PROGRAMS = bloom-terminal bloom-lottie-player

# Platform-specific implementations
if HOST_WINDOWS
PTY_SOURCE = pty_w32.c
FONT_RESOLVE_SOURCE = font_resolve_w32.c
else !HOST_WINDOWS
PTY_SOURCE = pty.c
if HOST_MACOS
FONT_RESOLVE_SOURCE = font_resolve_ct.c
else
FONT_RESOLVE_SOURCE = font_resolve_fc.c
endif
endif

bloom_terminal_SOURCES = main.c bloom_conf.c diag.c pager.c base64.c term.c term_bvt.c \
    rend.c rend_sdl3.c rend_sdl3_shader.c \
    rend_sdl3_atlas.c rend_sdl3_boxdraw.c font.c font_ft.c colr.c font_resolve.c \
    $(FONT_RESOLVE_SOURCE) png_writer.c png_reader.c unicode.c $(PTY_SOURCE) \
    platform.c platform_sdl3.c png_mode.c timer.c \
    bloom_bug.c heap_harden.c

# GPU glyph-coverage shader. The compiled SPIR-V is committed as a C header
# (shaders/glyph_coverage_frag_spv.h, generated by build-aux/bin2c.sh), so
# glslang is NOT a build dependency — the normal build just compiles the header.
# After editing the .glsl, run `make regen-shaders` (needs glslangValidator) to
# refresh the committed header, then commit it.
EXTRA_DIST = shaders/glyph_coverage.frag.glsl shaders/glyph_coverage_frag_spv.h

if HAVE_GLSLANGVALIDATOR
regen-shaders:
	@$(MKDIR_P) shaders
	$(GLSLANGVALIDATOR) -V -S frag \
	    $(srcdir)/shaders/glyph_coverage.frag.glsl \
	    -o shaders/glyph_coverage.frag.spv
	$(SHELL) $(top_srcdir)/build-aux/bin2c.sh \
	    shaders/glyph_coverage.frag.spv glyph_coverage_frag_spv \
	    > $(srcdir)/shaders/glyph_coverage_frag_spv.h
	@echo "  GEN      shaders/glyph_coverage_frag_spv.h"
CLEANFILES += shaders/glyph_coverage.frag.spv
endif

# Compiler flags
AM_CFLAGS = $(SDL3_CFLAGS) $(FREETYPE_CFLAGS) \
    $(HARFBUZZ_CFLAGS) $(LIBPNG_CFLAGS) $(BLOOM_VT_CFLAGS) \
    -DBLOOM_DATADIR='"$(datadir)"' -Wall -Wextra

# Linker flags
bloom_terminal_LDADD = $(SDL3_LIBS) \
    $(FREETYPE_LIBS) $(HARFBUZZ_LIBS) $(LIBPNG_LIBS) $(BLOOM_VT_LIBS) -lm

if HOST_WINDOWS
bloom_terminal_LDADD += -ladvapi32 -lshell32 -ldwmapi
bloom_terminal_LDFLAGS =
else !HOST_WINDOWS
if HOST_MACOS
bloom_terminal_LDFLAGS = -framework CoreText -framework CoreFoundation \
    -framework GameController -framework CoreHaptics \
    -framework CoreMotion -framework CoreMedia
else
AM_CFLAGS += $(FONTCONFIG_CFLAGS)
bloom_terminal_LDADD += $(FONTCONFIG_LIBS)
bloom_terminal_LDADD += -lutil
bloom_terminal_LDFLAGS = -rdynamic
endif
endif

AM_CFLAGS += -DPKGLIBDIR='"$(pkglibdir)"'

# bloom-lottie-player: standalone TUI Lottie player (no external deps, libc only)
bloom_lottie_player_SOURCES = bloom_lottie_player.c
bloom_lottie_player_LDADD =
bloom_lottie_player_LDFLAGS =

# Optional GTK4/libadwaita platform backend (built as dlopen plugin)
if HAVE_GTK4
pkglib_LTLIBRARIES = bloom-terminal-gtk4.la
bloom_terminal_gtk4_la_SOURCES = platform_gtk4.c gtk4_vulkan.c gtk4_vulkan.h
bloom_terminal_gtk4_la_CFLAGS = $(GTK4_CFLAGS) $(SDL3_CFLAGS) \
    $(FREETYPE_CFLAGS) $(HARFBUZZ_CFLAGS) $(LIBPNG_CFLAGS) \
    $(LIBDRM_CFLAGS) $(VULKAN_CFLAGS) $(BLOOM_VT_CFLAGS) \
    -DBLOOM_DATADIR='"$(datadir)"' -Wall -Wextra
bloom_terminal_gtk4_la_LDFLAGS = -module -avoid-version
bloom_terminal_gtk4_la_LIBADD = $(GTK4_LIBS) $(SDL3_LIBS) $(VULKAN_LIBS)
endif
